<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/content_frame"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<com.google.android.material.appbar.AppBarLayout
		android:id="@+id/appbarlayout_supporters"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		app:liftOnScroll="true">

		<com.google.android.material.appbar.MaterialToolbar
			android:id="@+id/toolbar"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:minHeight="?attr/actionBarSize"
			app:layout_scrollFlags="noScroll"
			app:title="@string/supporters" />

	</com.google.android.material.appbar.AppBarLayout>

	<androidx.core.widget.NestedScrollView
		android:id="@+id/scrollView"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:fillViewport="true"
		app:layout_behavior="@string/appbar_scrolling_view_behavior">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="16dp"
			android:clipToPadding="false">

			<!-- Pab -->
			<com.google.android.material.card.MaterialCardView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="?attr/colorSurface"
				app:cardCornerRadius="16dp"
				app:cardElevation="8dp">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="16dp"
					android:gravity="center_horizontal">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:orientation="vertical"
						tools:ignore="UselessParent">

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="wrap_content"
							android:orientation="horizontal">

							<com.google.android.material.imageview.ShapeableImageView
								android:id="@+id/pab_pfp"
								android:layout_width="100dp"
								android:layout_height="100dp"
								android:padding="1dp"
								app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Large"
								app:strokeColor="?attr/colorPrimary"
								app:strokeWidth="2dp"
								android:src="@drawable/pab" />

							<com.google.android.material.textview.MaterialTextView
								android:id="@+id/pab_text"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginStart="16dp"
								android:layout_gravity="center"
								android:textSize="24sp"
								android:textColor="?attr/colorOnPrimaryContainer"
								app:fontFamily="@font/rubik"
								android:textStyle="italic"
								app:fontVariationSettings="'wght' 800"
								android:includeFontPadding="false"
								android:text="@string/supporter_pab" />

						</LinearLayout>

						<LinearLayout
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:orientation="horizontal">

							<ImageView
								android:layout_width="100dp"
android:layout_height="match_parent"
android:minHeight="150dp"
								android:rotation="90"
								android:src="@drawable/squiggly_line" />

							<LinearLayout
								android:layout_width="match_parent"
								android:layout_height="match_parent"
								android:orientation="vertical"
								android:paddingStart="16dp"
								android:gravity="center_vertical">

								<com.google.android.material.chip.Chip
									android:id="@+id/pab_patron"
									style="@style/Widget.Material3.Chip.Assist"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="@string/patron_diamond_tier" />

								<com.google.android.material.chip.Chip
									android:id="@+id/pab_tester"
									style="@style/Widget.Material3.Chip.Assist"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="@string/app_tester" />

								<com.google.android.material.chip.Chip
									android:id="@+id/pab_idea"
									style="@style/Widget.Material3.Chip.Assist"
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:text="@string/idea_provider" />

							</LinearLayout>

						</LinearLayout>

					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

